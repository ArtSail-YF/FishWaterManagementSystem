<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.artsail.env.mapper.EnvWeatherMapper">
    <resultMap id="EnvWeatherVOMap" type="com.artsail.env.model.domain.EnvWeather">
        <id column="id" property="id"/>
        <result column="base_id" property="baseId"/>
        <result column="update_time" property="updateTime"/>
        <result column="air_temperature" property="airTemperature"/>
        <result column="humidity" property="humidity"/>
        <result column="wind_speed" property="windSpeed"/>
        <result column="wind_direction" property="windDirection"/>
        <result column="rainfall" property="rainfall"/>
        <result column="weather_condition" property="weatherCondition"/>
        <result column="data_source" property="dataSource"/>
        <result column="last_operator_id" property="lastOperatorId"/>
        <result column="base_name" property="baseName"/>
    </resultMap>
    <select id="selectAllWithNames" resultMap="EnvWeatherVOMap">
        SELECT w.*, b.base_name
        FROM env_weather w
        LEFT JOIN base_info b ON w.base_id = b.id
        ORDER BY w.base_id
    </select>
</mapper>