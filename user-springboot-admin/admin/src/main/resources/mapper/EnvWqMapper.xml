<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.artsail.env.mapper.EnvWqMapper">

    <resultMap id="EnvWqVOMap" type="com.artsail.env.model.domain.EnvWq">
        <id column="id" property="id"/>
        <result column="pond_id" property="pondId"/>
        <result column="update_time" property="updateTime"/>
        <result column="dissolved_oxygen" property="dissolvedOxygen"/>
        <result column="ph_value" property="phValue"/>
        <result column="water_temperature" property="waterTemperature"/>
        <result column="ammonia_nitrogen" property="ammoniaNitrogen"/>
        <result column="nitrite" property="nitrite"/>
        <result column="turbidity" property="turbidity"/>
        <result column="salinity" property="salinity"/>
        <result column="data_source" property="dataSource"/>
        <result column="last_operator_id" property="lastOperatorId"/>
        <result column="do_status" property="doStatus"/>
        <result column="ph_status" property="phStatus"/>
        <result column="pond_name" property="pondName"/>
        <result column="base_name" property="baseName"/>
    </resultMap>

    <select id="selectAllWithNames" resultMap="EnvWqVOMap">
        SELECT
            w.*,
            p.pond_name,
            b.base_name
        FROM env_wq w
        LEFT JOIN pond_info p ON w.pond_id = p.id AND p.is_delete = 0
        LEFT JOIN base_info b ON p.base_id = b.id
        ORDER BY w.update_time DESC
    </select>

</mapper>
