<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" modified="2026-05-29T10:00:00.000Z" agent="5.0 (Windows NT 10.0; Win64; x64)" version="21.3.7">
  <diagram id="plan-task-log-flow" name="计划-任务-日志数据流">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- 标题 -->
        <mxCell id="title" value="生产计划 → 生产任务 → 生产日志 数据流图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="500" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 计划方框 -->
        <mxCell id="plan-box" value="生产计划 (ProdPlan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="220" height="60" as="geometry"/>
        </mxCell>
        
        <!-- 计划字段 -->
        <mxCell id="plan-fields" value="· title 计划标题&#10;· planType 类型&#10;· startTime ~ endTime&#10;· status: draft/published/active/completed/cancelled" style="text;whiteSpace=wrap;html=1;rounded=1;fillColor=#f5f5f5;strokeColor=#bdbdbd;fontSize=11;fontColor=#555;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="170" width="220" height="120" as="geometry"/>
        </mxCell>
        
        <!-- 发布过程 -->
        <mxCell id="publish-edge" value="发布(Publish)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1976d2;strokeWidth=2;fontSize=11;fontColor=#1976d2;" edge="1" parent="1" source="plan-box" target="task-box">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="130"/>
            <mxPoint x="500" y="130"/>
          </mxGeometry>
        </mxCell>
        
        <!-- 任务方框 -->
        <mxCell id="task-box" value="生产任务 (ProdTask)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f57c00;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="220" height="60" as="geometry"/>
        </mxCell>
        
        <!-- 任务字段 -->
        <mxCell id="task-fields" value="· taskTitle 任务标题&#10;· assigneeId 执行人&#10;· actionTime 执行时间&#10;· deadlineTime 截止时间&#10;· status: pending/assigned/doing/done/skipped/expired" style="text;whiteSpace=wrap;html=1;rounded=1;fillColor=#f5f5f5;strokeColor=#bdbdbd;fontSize=11;fontColor=#555;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="170" width="220" height="140" as="geometry"/>
        </mxCell>
        
        <!-- 日志过程 -->
        <mxCell id="log-edge" value="执行打卡(Execute)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f57c00;strokeWidth=2;fontSize=11;fontColor=#f57c00;" edge="1" parent="1" source="task-box" target="log-box">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="800" y="130"/>
            <mxPoint x="800" y="130"/>
          </mxGeometry>
        </mxCell>
        
        <!-- 日志方框 -->
        <mxCell id="log-box" value="生产日志 (ProdLog)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="100" width="220" height="60" as="geometry"/>
        </mxCell>
        
        <!-- 日志字段 -->
        <mxCell id="log-fields" value="· taskId / planId 关联&#10;· logType 作业类型&#10;· quantity 实际用量&#10;· photoUrls 照片&#10;· gpsLat/Lng 打卡位置&#10;· actualWorkerId 实际执行人&#10;· verifyStatus: auto/pending/rejected&#10;· isBackfilled 是否补录" style="text;whiteSpace=wrap;html=1;rounded=1;fillColor=#f5f5f5;strokeColor=#bdbdbd;fontSize=11;fontColor=#555;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="170" width="220" height="170" as="geometry"/>
        </mxCell>
        
        <!-- 数据流向说明 -->
        <mxCell id="legend-title" value="图例" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="80" y="380" width="100" height="30" as="geometry"/>
        </mxCell>
        
        <mxCell id="legend-1" value="上游数据向下游流动" style="shape=ellipse;html=1;whiteSpace=wrap;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="420" width="160" height="40" as="geometry"/>
        </mxCell>
        
        <mxCell id="legend-2" value="箭头上的标签表示触发动作" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1976d2;strokeWidth=2;fontSize=11;" edge="1" parent="1">
          <mxGeometry x="80" y="480" width="160" as="geometry">
            <mxPoint x="80" y="480"/>
            <mxPoint x="240" y="480"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="legend-2-label" value="动作标签" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#1976d2;" vertex="1" connectable="0" parent="legend-2">
          <mxGeometry x="0" y="-10" relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
